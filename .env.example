PORT=3000

# 必填：服务端 Supabase 凭据
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_UPLOAD_BUCKET=uploads

# 阿里云 OSS：主存储只写 OSS；旧 Supabase 文件由可恢复回填任务复制
OURHOME_OSS_STORAGE_MODE=primary
ALIYUN_OSS_REGION=oss-cn-beijing
ALIYUN_OSS_ENDPOINT=https://oss-cn-beijing.aliyuncs.com
ALIYUN_OSS_BUCKET=
ALIYUN_OSS_ACCESS_KEY_ID=
ALIYUN_OSS_ACCESS_KEY_SECRET=
OURHOME_SUPABASE_STORAGE_MIRROR=0
OURHOME_OSS_BACKFILL_BATCH=32

# 普通聊天图片满 30 天、且已有 attachment_summary 后才删除原图
CHAT_PHOTO_RETENTION_DAYS=30

# 必填：OurHome 登录与令牌签名
APP_PASSWORD=
APP_TOKEN_SECRET=
APP_TOKEN_TTL_DAYS=180

# 可选：没有 API 站点档案时的后备线路
ANTHROPIC_API_KEY=
ANTHROPIC_API_BASE_URL=https://api.anthropic.com/v1

# 可选：记忆向量
JINA_API_KEY=

# 可选覆盖：不填时后端会自动生成并保存到 Supabase Vault
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ourhome@example.com

# 可选：AgentMail 注册实时收信 Webhook 时使用；Render 通常可由 RENDER_EXTERNAL_URL 自动取得
AGENTMAIL_WEBHOOK_BASE_URL=
